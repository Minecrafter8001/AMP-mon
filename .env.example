# Required Discord application settings; never commit a populated .env.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Root Controller or Hybrid web URL. Keep TLS certificate verification enabled.
AMP_URL=https://amp.example.com/
AMP_USERNAME=discord-monitor
AMP_PASSWORD=
# Optional AMP service-login token; not a reusable one-time 2FA code.
AMP_LOGIN_TOKEN=